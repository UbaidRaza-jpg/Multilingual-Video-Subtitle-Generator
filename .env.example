# Multilingual Video Subtitle Generator Environment Template
# Copy this file to .env and populate with your own credentials.
# NEVER commit .env into source control.

# ==========================================
# Admin Authentication API Key
# ==========================================
# Secret key used to access protected administrative endpoints (/admin/stats, /admin/cleanup)
# Provide a long random hexadecimal string (e.g. generated via python -c "import secrets; print(secrets.token_hex(32))")
ADMIN_API_KEY=your_secure_admin_api_key_here

# ==========================================
# CORS Allowed Origins
# ==========================================
# Comma-separated list of allowed origins. Set to specific domains in production.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8501,http://127.0.0.1:8501,https://built-by-ubaid-multilingual-video-subtitle-generator.streamlit.app,https://ubaidraza-jpg.github.io

# ==========================================
# (Optional) SMTP Email Notification Keys
# ==========================================
# Credentials for sending completion/failure emails to users.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

# ==========================================
# (Optional) External Translation API Keys
# ==========================================
# Official API keys for translation fallbacks (deep-translator is used for free by default)
# DEEPL_API_KEY=your-deepl-key-here
# GOOGLE_TRANSLATION_API_KEY=your-google-cloud-key-here

# ==========================================
# (Optional) Public Server Base URL
# ==========================================
# Used for constructing absolute download links in email notifications
SERVER_URL=http://localhost:8000
